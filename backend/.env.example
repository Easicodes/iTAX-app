# Copy this file to .env and fill in your own values.

# MongoDB Atlas connection string (see README Step 1)
MONGO_URI=mongodb+srv://itax_admin:Ia1fhE8ZMaop3gLh@cluster0.whqkyv3.mongodb.net/itax

# Any long random string (used to sign login tokens)
JWT_SECRET=ghhjhhgfdfghkkhfdfgghhjhf

# Optional but recommended: enables the real Retrieval-Augmented Generation (RAG)
# pipeline described in Chapter 4 — embeddings + semantic search + grounded chat
# completions. Leave blank to fall back to free, built-in rule-based answers.
# Get a key at https://platform.openai.com/api-keys (requires adding billing;
# embeddings + a handful of chat replies for grading cost well under $1).
# After setting this, run `npm run ingest` once to build the knowledge base.
OPENAI_API_KEY=

# Port the backend will listen on
PORT=5000

# The URL your frontend will be served from (for CORS). Use * while testing locally.
FRONTEND_ORIGIN=*
